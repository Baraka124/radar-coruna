@app.put('/api/study/phase14')
def save_phase14(d: Phase14Record,user=Depends(user_for)):
    writable(user)
    if not phase14_key(d.kind,d.key):failure(422,'Identificador de registro incorrecto')
    try:clean=validate_phase14(d.kind,d.payload)
    except ValueError as err:failure(422,str(err))
    pid=None
    with conn() as c:
        if d.kind in ('centre','implementation'):
            center=d.key.split(':')[0]
        elif d.kind=='professional':
            center=d.centre or user['centre']
            if center not in [c['code'] for c in CENTRES]:failure(422,'Centro de profesional obligatorio')
        else:
            pid=d.key.split(':')[0]
            patient=patient_for(c,user,pid)
            center=patient['centre']
            if d.kind=='baseline' and json.loads(patient['payload']).get('status')!='incluido':
                failure(422,'La ficha basal requiere paciente incluido')
            if d.kind=='visit':
                stage=d.key.split(':')[1]
                if not c.execute('SELECT 1 FROM visits WHERE patient=? AND vtype=?',(pid,stage)).fetchone():
                    failure(422,'La evaluación aún no está registrada')
                assessor=clean.get('assessor_code')
                if assessor:
                    other=c.execute('SELECT centre FROM phase14_records WHERE kind=? AND record_key=?',('professional',assessor)).fetchone()
                    if not other or other['centre']!=center:failure(422,'Evaluador no pertenece a un profesional registrado del centro')
        accessible(user,center)
        if d.kind=='screening' and clean.get('screen_code'):
            for r in c.execute("SELECT record_key,payload FROM phase14_records WHERE kind='screening' AND record_key<>?",(d.key,)):
                if json.loads(r['payload']).get('screen_code')==clean['screen_code']:
                    failure(409,'Código de cribado utilizado por otro registro')
        if d.kind=='screening' and clean.get('consent_date'):
            patient=c.execute('SELECT payload FROM patients WHERE id=?',(d.key,)).fetchone()
            patientdata=json.loads(patient['payload'])
            if patientdata.get('enrolDate') and clean['consent_date']>patientdata['enrolDate']:
                failure(422,'El consentimiento no puede ser posterior a la inclusión')
        old=c.execute('SELECT * FROM phase14_records WHERE kind=? AND record_key=?',(d.kind,d.key)).fetchone()
        if old and old['centre']!=center:failure(403,'Registro perteneciente a otro centro')
        prev=json.loads(old['payload']) if old else None
        rev=old['rev'] if old else 0
        if rev!=d.rev:failure(409,'Otra sesión modificó el registro; recargue')
        if prev==clean:return {'ok':True,'rev':rev,'unchanged':True}
        if old and not 8<=len(d.reason.strip())<=240:failure(422,'Indique motivo de corrección (8–240 caracteres)')
        stamp=now()
        if old:
            c.execute('UPDATE phase14_records SET payload=?,rev=rev+1,username=?,updated_at=? WHERE kind=? AND record_key=?',
              (json.dumps(clean,ensure_ascii=False),user['username'],stamp,d.kind,d.key))
        else:
            c.execute('INSERT INTO phase14_records VALUES (?,?,?,?,?,?,?,?)',
              (d.kind,d.key,center,pid,json.dumps(clean,ensure_ascii=False),1,user['username'],stamp))
        log_audit(c,user,'UPDATE' if old else 'CREATE','phase14_'+d.kind,d.key,center,
         patient_id=pid or '',old=prev,new=clean,revision_from=rev if old else None,
         revision_to=rev+1,reason=d.reason.strip() if old else 'Primera captura de variable')
    return {'ok':True,'rev':rev+1}


