def score(data):
    keys = ['rescue', 'exacerb', 'dyspnea', 'activity']
    if data.get('status') == 'no_realizada':
        return None
    if not all(data.get(k) in ('si', 'no') for k in keys):
        return None
    return sum(w for k, w in zip(keys, [3, 2, 2, 1]) if data[k] == 'si')


@contextmanager
def conn():
    DB_FILE.parent.mkdir(parents=True, exist_ok=True)
    with LOCK:
        c = sqlite3.connect(str(DB_FILE), timeout=10)
        c.row_factory = sqlite3.Row
        c.execute('PRAGMA foreign_keys=ON')
        c.execute('PRAGMA journal_mode=WAL')
        try:
            yield c
            c.commit()
        except Exception:
            c.rollback()
            raise
        finally:
            c.close()


def rowdict(r):
    return dict(r) if r is not None else None


