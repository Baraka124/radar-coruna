@app.put('/api/patients/{code}')
def update_patient(code: str,d: Patient,request: Request,user=Depends(user_for)):
    writable(user)
    if d.id!=code:failure(400,'No se puede cambiar el código')
    reason=correction_reason(request)
    with conn() as c:
        old=patient_for(c,user,code)
        if old['centre']!=d.center:failure(403,'No se permite cambiar el centro en este prototipo')
        if d.rev!=old['rev']:failure(409,'Ficha modificada por otra sesión; recargue antes de guardar')
        prior=json.loads(old['payload'])
        updated=d.model_dump(exclude={'rev'})
        if updated==prior: return {'ok':True,'id':code,'rev':old['rev'],'unchanged':True}
        # A corrected baseline date must not silently invalidate an existing V0.
        # There is no atomic participant+V0 correction workflow in this local pilot;
        # reject the edit rather than leave a contradictory longitudinal record.
        baseline=c.execute('SELECT payload FROM visits WHERE patient=? AND vtype=?',(code,'V0')).fetchone()
        if baseline and json.loads(baseline['payload'])['date']!=d.enrolDate:
            failure(409,'La fecha de inclusión debe coincidir con V0; requiere corrección coordinada')
        if prior.get('status')=='incluido' and updated['status']=='cribado':
            # Once any visit, episode or contact exists, moving back to screening
            # would strand clinical follow-up against a non-included participant.
            if any(c.execute(f'SELECT 1 FROM {table} WHERE patient=? LIMIT 1',(code,)).fetchone()
                   for table in ('visits','episodes','contacts')):
                failure(409,'Existen visitas o eventos; no se puede volver a cribado sin conciliación')
        c.execute('UPDATE patients SET payload=?,rev=rev+1,updated_at=? WHERE id=?',(json.dumps(updated),now(),code))
        log_audit(c,user,'UPDATE','patient',code,d.center,patient_id=code,old=prior,new=updated,
                  revision_from=old['rev'],revision_to=old['rev']+1,reason=reason)
    return {'ok':True,'id':code,'rev':old['rev']+1}

