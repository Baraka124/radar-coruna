        if d.episodeNo is not None:failure(422,'El número R074 se asigna automáticamente; no enviarlo manualmente')
        prior=[json.loads(x['payload']) for x in c.execute('SELECT payload FROM episodes WHERE patient=?',(d.patient,))]
        # Retain an anti-double-submit guard, but allow another event type on the same day.
        if any(x['date']==d.date and x.get('kind','agudizacion')==d.kind and x.get('severity')==d.severity and
               x.get('copd','')==d.copd and x.get('steroids','')==d.steroids and x.get('antibiotics','')==d.antibiotics for x in prior):
            failure(409,'Posible duplicado exacto: revise el episodio antes de guardarlo')
        d.episodeNo=max((x.get('episodeNo') or 0 for x in prior),default=0)+1
        if d.episodeNo>9999:failure(422,'Límite de numeración R074 superado')
        saved=d.model_dump()
