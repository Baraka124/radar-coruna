def excel_export(user=Depends(user_for)):
    """Generate scoped, auditable XLSX from a consistent DB snapshot."""
    from export_research import create_excel_snapshot
    with conn() as c:
        c.execute('BEGIN')
        scope=' WHERE centre=?' if user['centre'] else ''
        params=(user['centre'],) if user['centre'] else ()
        source=c.execute('SELECT * FROM patients'+scope,params).fetchall()
        codes=[r['id'] for r in source]
        where=' WHERE patient IN ('+','.join('?' for _ in codes)+')' if codes else ' WHERE 0'
        patients=[{**json.loads(r['payload']), 'rev':r['rev'], 'created_by':r['created_by'], 'updated_at':r['updated_at']} for r in source]
        visits=hydrate(c,'visits',where,codes)
        episodes=hydrate(c,'episodes',where,codes)
        contacts=hydrate(c,'contacts',where,codes)
        log_audit(c,user,'EXPORT','xlsx','SNAPSHOT',user['centre'],reason='Descarga autorizada XLSX')
        auditrows=[rowdict(r) for r in c.execute('SELECT * FROM audit ORDER BY id ASC')] if user['role']=='admin' else []
        change_rows=[rowdict(r) for r in c.execute('''SELECT f.id,f.audit_id,a.happened_at,a.username,a.centre,a.kind,a.object_id,a.participant_id,
                    a.verb,a.reason,a.revision_from,a.revision_to,f.field_name,f.prior_value,f.new_value
                    FROM audit_field_changes f JOIN audit a ON a.id=f.audit_id ORDER BY f.id ASC''')] if user['role']=='admin' else []
        obsp_where=' WHERE participant IN ('+','.join('?' for _ in codes)+')' if codes else ' WHERE 0'
        observations=[{**dict(r),'value':json.loads(r['value_json'])} for r in c.execute('SELECT * FROM study_observations'+obsp_where+' ORDER BY participant,visit_type,variable_code',codes)]
        missed_where=' WHERE participant IN ('+','.join('?' for _ in codes)+')' if codes else ' WHERE 0'
        missing=[dict(r) for r in c.execute('SELECT * FROM missing_data'+missed_where+' ORDER BY participant,visit_type,field_code',codes)]
