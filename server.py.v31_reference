def now():
    return datetime.now(timezone.utc).isoformat()


def validate_date(value: str):
    if value:
        try:
            date.fromisoformat(value)
        except ValueError:
            raise ValueError('Fecha inválida; se requiere AAAA-MM-DD')
    return value


