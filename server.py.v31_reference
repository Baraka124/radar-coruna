                    'no_recogido','rechazo','desconocido']

    @field_validator('field_code')
    @classmethod
    def permitted_missing_code(cls, value):
        legacy={'cat','mmrc','rescue','exacerb','dyspnea','activity',
                'adherence','action','fev1','ratio','spiroDate','priorEx','priorHosp'}
        if value in legacy:return value
        m=re.fullmatch(r'R(0\d\d|10[0-7])',value)
        if not m or not 1 <= int(m.group(1)) <= 106:
            raise ValueError('Código de campo no reconocido; utilice R001–R106 o un campo básico')
        return value
    rev: int | None = None
    correction_reason: str = ''

    @field_validator('participant')
    @classmethod
    def check_synthetic(cls, v):
        if not CODE.fullmatch(v): raise ValueError('Código sintético inválido')
        return v


