def meaningful(value):
    return value is not None and value != ''


def log_audit(c, user, verb, kind, oid, centre, *, patient_id='', old=None, new=None, revision_from=None, revision_to=None, reason=''):
    """Transactionally log an event and its exact field differences.

    Older v0.6 events remain event-only. Empty values are retained on updates.
    Hash is a diagnostic fingerprint of the new record, NOT a tamper-proof signature.
    """
    if old is None and new is not None:
        # Initial captures are recorded in TRAZABILIDAD and represented by current
        # data tables; CAMBIOS_CAMPO is reserved for actual subsequent corrections.
        changed={}
    elif old is not None and new is not None:
        changed={k:(old.get(k),v) for k,v in new.items() if old.get(k)!=v}
    else:
        changed={}
    stamp=now()
    digest=hashlib.sha256(json.dumps(new,sort_keys=True,ensure_ascii=False,separators=(',',':')).encode()).hexdigest() if new is not None else None
    cur=c.execute("""INSERT INTO audit(happened_at,username,role,centre,verb,kind,object_id,reason,revision_from,revision_to,participant_id,field_count,record_digest)
                  VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                  (stamp,user['username'],user['role'],centre,verb,kind,oid,reason or None,revision_from,revision_to,patient_id or None,len(changed),digest))
    aid=cur.lastrowid
    if changed:
        c.executemany('INSERT INTO audit_field_changes(audit_id,field_name,prior_value,new_value) VALUES (?,?,?,?)',
          [(aid,k,json.dumps(before,ensure_ascii=False) if before is not None else None,
            json.dumps(after,ensure_ascii=False)) for k,(before,after) in changed.items()])
    return aid


def correction_reason(request: Request):
    reason=unquote(request.headers.get('X-RADAR-CHANGE-REASON','')).strip()
    if len(reason)<8 or len(reason)>240:
        failure(422,'Indique un motivo de corrección (8–240 caracteres), sin datos personales')
    return reason


