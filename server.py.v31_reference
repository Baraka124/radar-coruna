@app.put('/api/study/missing')
def set_missing_data(d: MissingDatum, user=Depends(user_for)):
    writable(user)
    if d.visit_type != 'V0' and d.field_code in ('fev1','ratio','spiroDate','priorEx','priorHosp'):
        failure(422,'Variable exclusivamente basal')
    with conn() as c:
        p=patient_for(c,user,d.participant)
        if json.loads(p['payload'])['status']!='incluido':failure(422,'Requiere participante incluido')
        if not c.execute('SELECT 1 FROM visits WHERE patient=? AND vtype=?',(d.participant,d.visit_type)).fetchone():
            failure(422,'Registre primero la visita')
        row=c.execute('SELECT * FROM missing_data WHERE participant=? AND visit_type=? AND field_code=?',
                      (d.participant,d.visit_type,d.field_code)).fetchone()
        old_rev=row['rev'] if row else 0
        if (d.rev or 0)!=old_rev: failure(409,'Registro modificado; actualice la página')
        if row and row['reason'] == d.reason: return {'ok':True,'rev':old_rev,'unchanged':True}
        if row and not 8<=len(d.correction_reason.strip())<=240:
            failure(422,'La corrección de motivo requiere justificación (8–240 caracteres)')
        stamp=now()
        if row:
            c.execute('UPDATE missing_data SET reason=?, rev=rev+1, username=?, updated_at=? WHERE participant=? AND visit_type=? AND field_code=?',
                     (d.reason,user['username'],stamp,d.participant,d.visit_type,d.field_code))
        else:
            c.execute('INSERT INTO missing_data VALUES (?,?,?,?,?,?,?)',
                      (d.participant,d.visit_type,d.field_code,d.reason,1,user['username'],stamp))
        log_audit(c,user,'UPDATE' if row else 'CREATE','missing_data',f'{d.participant}:{d.visit_type}:{d.field_code}',
                  p['centre'],patient_id=d.participant,
                  old={'reason':row['reason']} if row else None,new={'reason':d.reason},
                  revision_from=old_rev if row else None,revision_to=old_rev+1,
                  reason=d.correction_reason.strip() if row else 'Primer motivo de ausencia documentado')
    return {'ok':True,'rev':old_rev+1}


