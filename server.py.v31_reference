def migrate_legacy_episode_numbers(c):
    """One-time, synthetic-only assignment of stable CRD R074 per participant.

    Preserve existing internal episode IDs and contact references. Numbers are allocated
    in historical SQLite insertion order, not used as diagnostic codes.
    """
    occupied={}
    rows=c.execute('SELECT id,patient,payload FROM episodes ORDER BY rowid').fetchall()
    for r in rows:
        d=json.loads(r['payload'])
        if isinstance(d.get('episodeNo'),int):
            occupied.setdefault(r['patient'],set()).add(d['episodeNo'])
    for r in rows:
        d=json.loads(r['payload'])
        if isinstance(d.get('episodeNo'),int):continue
        used=occupied.setdefault(r['patient'],set())
        num=next(i for i in range(1,10000) if i not in used)
        before=dict(d);d['episodeNo']=num
        # Old events did not distinguish event kinds: preserve their existing meaning.
        d.setdefault('kind','agudizacion')
        c.execute('UPDATE episodes SET payload=? WHERE id=?',(json.dumps(d),r['id']))
        used.add(num)
        p=c.execute('SELECT centre FROM patients WHERE id=?',(r['patient'],)).fetchone()
        log_audit(c,{'username':'system','role':'admin'},'MIGRATE','episode',r['id'],p['centre'] if p else None,
                  patient_id=r['patient'],old=before,new=d,reason='Asignación R074 desde versión anterior; sin alterar ID')



def migrate_legacy_care_assessments(c):
    """Non-destructive v0.21 migration: only verified linked contacts imply Sí.

    A missing contact remains blank (unknown), NEVER No. Old contact and episode
    identifiers stay unchanged. Audit the change; migration is idempotent.
    """
    rows=c.execute('SELECT id,patient,payload FROM episodes ORDER BY rowid').fetchall()
    for row in rows:
        before=json.loads(row['payload'])
        updated=dict(before)
        linked=c.execute('SELECT payload FROM contacts WHERE episode_id=? AND patient=?',
                         (row['id'],row['patient'])).fetchall()
        by_kind={'urgencias':[], 'ingreso':[]}
        for item in linked:
            ct=json.loads(item['payload'])
            if before.get('copd')=='si' and ct.get('copd')=='si' and ct.get('type') in by_kind and ct.get('date'):
                by_kind[ct['type']].append(ct['date'])
        for kind,status_key,date_key in [('urgencias','emergencyStatus','emergencyDate'),
                                         ('ingreso','admissionStatus','admissionDate')]:
            if by_kind[kind] and not updated.get(status_key):
                updated[status_key]='si'
                updated[date_key]=min(by_kind[kind])
        if updated!=before:
            updated['careAssessmentRev']=int(before.get('careAssessmentRev') or 0)+1
            c.execute('UPDATE episodes SET payload=? WHERE id=?',(json.dumps(updated),row['id']))
            p=c.execute('SELECT centre FROM patients WHERE id=?',(row['patient'],)).fetchone()
            log_audit(c,{'username':'system','role':'admin'},'MIGRATE','episode',row['id'],
                      p['centre'] if p else None,patient_id=row['patient'],old=before,new=updated,
                      revision_from=before.get('careAssessmentRev',0),revision_to=updated['careAssessmentRev'],
                      reason='R081/R082 inferidos solo de contactos previos vinculados; otras respuestas sin registrar')


def reconcile_contact_care(c,user,episode_id,contact_type,contact_date,centre,patient_id,contact_copd):
    """A documented contact is affirmative evidence, but never infer negatives."""
    if not episode_id or contact_type not in ('urgencias','ingreso'): return
    row=c.execute('SELECT payload FROM episodes WHERE id=? AND patient=?',(episode_id,patient_id)).fetchone()
    if not row: return
    before=json.loads(row['payload'])
    if contact_copd!='si' or before.get('copd')!='si': return  # No inferir relación con EPOC
    after=dict(before)
    status_key,date_key = (('emergencyStatus','emergencyDate') if contact_type=='urgencias'
                           else ('admissionStatus','admissionDate'))
    after[status_key]='si'
    if not after.get(date_key) or contact_date < after[date_key]:
        after[date_key]=contact_date
    if before==after:return
    after['careAssessmentRev']=int(before.get('careAssessmentRev') or 0)+1
    c.execute('UPDATE episodes SET payload=? WHERE id=?',(json.dumps(after),episode_id))
    log_audit(c,user,'UPDATE','episode',episode_id,centre,patient_id=patient_id,
              old=before,new=after,revision_from=before.get('careAssessmentRev',0),
              revision_to=after['careAssessmentRev'],
              reason=f'R081/R082 actualizado por contacto {contact_type} documentado')


def failure(code, msg):
    raise HTTPException(status_code=code, detail=msg)


def user_for(request: Request):
    token=request.cookies.get('radar_session','')
    if not token:
        failure(401,'Inicie sesión')
    with conn() as c:
        row=c.execute('SELECT u.*,s.csrf_hash FROM sessions s JOIN users u ON u.id=s.user_id WHERE s.token_hash=? AND s.expires>?',(hashlib.sha256(token.encode()).hexdigest(),now())).fetchone()
    if not row:
        failure(401,'Sesión no válida o caducada')
    user=rowdict(row)
    if request.method not in ('GET','HEAD','OPTIONS'):
        csrf=request.headers.get('X-RADAR-CSRF','')
        if not csrf or not secrets.compare_digest(hashlib.sha256(csrf.encode()).hexdigest(),user['csrf_hash']):
            failure(403,'Falta protección CSRF')
        origin=request.headers.get('origin')
        if origin and origin.rstrip('/')!=str(request.base_url).rstrip('/'):
            failure(403,'Origen no permitido')
    return user


def public_user(user):
