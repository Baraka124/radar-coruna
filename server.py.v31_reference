@app.put('/api/study/observations/{pid}/{visit}')
def save_study_observations(pid: str,visit: str,body: ObservationBatch,user=Depends(user_for)):
    writable(user)
    if visit not in ('V0','V1','V2'): failure(422,'Visita inválida')
    if not body.observations or len(body.observations)>60: failure(422,'Se requiere al menos un campo (máximo 60)')
    if set(body.revisions)-set(body.observations): failure(422,'Revisiones de variables desconocidas')
    # Validate all values before beginning a transaction; never silently accept unknown fields.
    checked={}
    for code,value in body.observations.items():
        try: checked[code]=validate_study(code,visit,value)
        except ValueError as ex: failure(422,f'{code}: {ex}')
    with conn() as c:
        p=patient_for(c,user,pid)
        if json.loads(p['payload'])['status']!='incluido': failure(422,'Requiere inclusión previa')
        v=c.execute('SELECT 1 FROM visits WHERE patient=? AND vtype=?',(pid,visit)).fetchone()
        if not v: failure(422,f'Registre primero la visita {visit}')
        for code,value in checked.items():
            row=c.execute('''SELECT * FROM study_observations WHERE participant=? AND visit_type=? AND variable_code=?''',(pid,visit,code)).fetchone()
            expected=body.revisions.get(code,0)
            actual=row['rev'] if row else 0
            if expected!=actual: failure(409,f'{code}: registro modificado; recargue antes de guardar')
            if row:
                old=json.loads(row['value_json'])
                if value!=old and not 8<=len(body.reason.strip())<=240:
                    failure(422,'La modificación requiere un motivo (8–240 caracteres)')
        changed=0
        for code,value in checked.items():
            row=c.execute('SELECT * FROM study_observations WHERE participant=? AND visit_type=? AND variable_code=?',(pid,visit,code)).fetchone()
            old=json.loads(row['value_json']) if row else None
            if old==value: continue
            if row:
                c.execute('''UPDATE study_observations SET value_json=?,rev=rev+1,username=?,updated_at=?
                  WHERE participant=? AND visit_type=? AND variable_code=?''',
                  (json.dumps(value,ensure_ascii=False),user['username'],now(),pid,visit,code))
            elif value is not None:
                c.execute('''INSERT INTO study_observations VALUES (?,?,?,?,?,?,?)''',
                  (pid,visit,code,json.dumps(value,ensure_ascii=False),1,user['username'],now()))
            else:
                continue
            log_audit(c,user,'UPDATE' if row else 'CREATE','crd_variable',f'{pid}:{visit}:{code}',p['centre'],
              patient_id=pid,old={code:old} if row else None,new={code:value},
              revision_from=row['rev'] if row else None,revision_to=(row['rev']+1 if row else 1),
              reason=body.reason.strip() if row else 'Medición inicial de CRD v0.9')
            changed+=1
    return {'ok':True,'changed':changed,'participant':pid,'visit':visit}


