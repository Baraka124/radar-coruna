def check_visit(c,d,p):
    if p['status']!='incluido':failure(422,'Participante aún en cribado')
    if d.type=='V0' and d.date!=p['enrolDate']: failure(422,'V0 debe coincidir con inclusión')
    if d.type!='V0' and not c.execute('SELECT 1 FROM visits WHERE patient=? AND vtype=?',(d.patient,'V0')).fetchone():failure(422,'Debe existir V0 antes de seguimiento')
    # Longitudinal dates: V1/V2 cannot precede the baseline date.
    if d.type!='V0' and d.date<p['enrolDate']:failure(422,'Seguimiento anterior a línea basal')
    # Chronological impossibilities are enforced; optional visit-window tolerances
    # remain warnings pending scientific protocol approval.
    other='V2' if d.type=='V1' else 'V1' if d.type=='V2' else None
    if other:
        prior=c.execute('SELECT payload FROM visits WHERE patient=? AND vtype=?',(d.patient,other)).fetchone()
        if prior:
            otherdate=json.loads(prior['payload'])['date']
            if (d.type=='V1' and d.date>=otherdate) or (d.type=='V2' and d.date<=otherdate):
                failure(422,'Orden cronológico V1/V2 incorrecto')

