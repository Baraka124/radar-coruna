    @field_validator('id')
    @classmethod
    def synthetic_id(cls, v):
        if not CODE.fullmatch(v):
            raise ValueError('Sólo se permiten códigos de simulación SIM-')
        return v

    @field_validator('enrolDate', 'spiroDate', 'created', 'deathDate', 'birthDate', 'consentDate', 'lastInformationDate')
    @classmethod
    def dates(cls, v):
        return validate_date(v)

    @model_validator(mode='after')
    def clinical_rules(self):
        if self.birthDate and self.enrolDate:
            birth, enrol = date.fromisoformat(self.birthDate), date.fromisoformat(self.enrolDate)
            if birth >= enrol:
                raise ValueError('La fecha de nacimiento debe preceder a la inclusión')
            derived_age = enrol.year - birth.year - ((enrol.month, enrol.day) < (birth.month, birth.day))
            if not 0 <= derived_age <= 110:
                raise ValueError('Edad derivada fuera del intervalo admitido')
            self.age = derived_age
        if self.priorExModerate is not None and self.priorExSevere is not None:
            count = self.priorExModerate + self.priorExSevere
            if count > 50:
                raise ValueError('El recuento total de agudizaciones excede el límite del prototipo')
            self.priorEx = count
        if self.status == 'incluido' and self.weeks is not None and self.weeks < 4:
            raise ValueError('La estabilidad requiere al menos 4 semanas sin agudización')
        if self.eligibilityDecision == 'no_elegible' and self.status == 'incluido':
            raise ValueError('Un cribado no elegible no puede quedar incluido')
        if self.status == 'incluido' and self.activeExacerb == 'si':
            raise ValueError('Agudización activa: posponer inclusión y revisar según protocolo')
        if self.status == 'incluido' and self.screenFailureReason:
            raise ValueError('Un participante incluido no puede conservar motivo de no inclusión')
        if self.eligibilityDecision == 'elegible' and self.screenFailureReason:
            raise ValueError('Retire el motivo de exclusión si declara elegible')
        if self.consentDate and self.enrolDate and self.consentDate > self.enrolDate:
            raise ValueError('La fecha del consentimiento no puede ser posterior a la inclusión')
        if self.consentDate and self.consent not in ('si','retirado'):
            raise ValueError('Fecha de consentimiento: indique firmado o retirado')
        if self.lastInformationDate and self.enrolDate and self.lastInformationDate < self.enrolDate:
            raise ValueError('La última información no puede ser anterior a la inclusión')
        if self.vitalStatus == 'fallecido' and not self.deathDate:
            raise ValueError('En fallecimiento, registre la fecha; la causa puede ser desconocida')
        if self.vitalStatus != 'fallecido' and (self.deathDate or self.deathCause):
            raise ValueError('Fecha y causa de muerte solo se permiten con estado fallecido')
        if self.deathDate and self.enrolDate and self.deathDate < self.enrolDate:
            raise ValueError('La fecha de fallecimiento no puede preceder al inicio del estudio')
        if self.status == 'incluido':
            if self.consent != 'si' or self.copd != 'si' or not self.enrolDate or not self.spiroDate:
                raise ValueError('La inclusión exige consentimiento, EPOC y fechas basales')
        if self.spiroDate and self.enrolDate and self.spiroDate > self.enrolDate:
            raise ValueError('Espirometría posterior a fecha basal')
        return self


