@app.put('/api/episodes/{episode_id}/care')
def update_episode_care(episode_id: str, d: EpisodeCareAssessment, user=Depends(user_for)):
    """Record R081/R082 Sí/No/NC per episode with revision and change history."""
    writable(user)
    with conn() as c:
        row=c.execute('SELECT id,patient,payload FROM episodes WHERE id=?',(episode_id,)).fetchone()
        if not row:failure(404,'Episodio no encontrado')
        p=patient_for(c,user,row['patient'])  # blocks cross-centre access
        before=json.loads(row['payload'])
        rev=int(before.get('careAssessmentRev') or 0)
        if d.rev!=rev:failure(409,'Otra sesión modificó R081/R082; recargue la ficha')
        linked=[json.loads(x['payload']) for x in c.execute(
            'SELECT payload FROM contacts WHERE episode_id=? AND patient=?',
            (episode_id,row['patient'])).fetchall()]
        if (d.emergencyStatus=='si' or d.admissionStatus=='si') and before.get('copd')!='si':
            failure(422,'R081/R082 por EPOC requieren episodio relacionado con EPOC confirmado')
        for kind,status in [('urgencias',d.emergencyStatus),('ingreso',d.admissionStatus)]:
            if status in ('no','nc','') and any(x.get('type')==kind and x.get('copd')=='si' and before.get('copd')=='si' for x in linked):
                failure(422,f'{kind}: ya existe un contacto documentado; no puede registrar No/NC o dejarlo vacío')
        after=dict(before)
        for key in ('emergencyStatus','admissionStatus','emergencyDate','admissionDate'):
            after[key]=getattr(d,key)
        if all(before.get(k,'')==after[k] for k in
               ('emergencyStatus','admissionStatus','emergencyDate','admissionDate')):
            return {'ok':True,'rev':rev,'unchanged':True}
        if rev and not 8<=len(d.reason.strip())<=240:
            failure(422,'La corrección de una respuesta previa exige motivo (8–240 caracteres)')
        after['careAssessmentRev']=rev+1
        # Serialize normalized Episode model; preserve legacy metadata in the source record.
        Episode.model_validate(after)
        c.execute('UPDATE episodes SET payload=? WHERE id=?',(json.dumps(after),episode_id))
        log_audit(c,user,'UPDATE','episode',episode_id,p['centre'],patient_id=row['patient'],
                  old=before,new=after,revision_from=rev,revision_to=rev+1,
                  reason=d.reason.strip() or 'Primera valoración R081/R082')
    return {'ok':True,'rev':rev+1}


@app.post('/api/contacts',status_code=201)
def new_contact(d: Contact,user=Depends(user_for)):
    writable(user)
    with conn() as c:
        p=patient_for(c,user,d.patient)
        if json.loads(p['payload'])['status']!='incluido':failure(422,'No incluido')
        if d.event:
            er=c.execute('SELECT patient FROM episodes WHERE id=?',(d.event,)).fetchone()
            if not er or er['patient']!=d.patient: failure(422,'Episodio vinculado de otro paciente')
        if c.execute('SELECT 1 FROM contacts WHERE id=?',(d.id,)).fetchone():failure(409,'Contacto duplicado')
        # Two legitimate urgent-care encounters may share a date/type. Keep each unique
