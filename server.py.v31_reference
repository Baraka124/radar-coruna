    mmrc: int | None = Field(None, ge=0, le=4)
    smoking: Literal['', 'actual', 'ex', 'nunca', 'nc'] = ''
    adherence: Literal['', 'pendiente', 'buena', 'regular', 'mala', 'ne'] = ''  # legacy; not a clinical adherence measure
    ianusVerified: Literal['', 'si', 'no'] = ''
    ianusCollected: Literal['', 'si', 'no', 'nv'] = ''
    ianusCheckedAt: str = ''
    rescue: YESNO = ''
    exacerb: YESNO = ''
    dyspnea: YESNO = ''
    activity: YESNO = ''
    action: Literal['', 'seguimiento', 'revision', 'educacion', 'derivacion', 'otro'] = ''
    inhaler: YESNO = ''
    education: YESNO = ''
    referral: YESNO = ''
    status: Literal['parcial', 'completa', 'no_realizada'] = 'parcial'
    lama: YESNO = ''
    laba: YESNO = ''
    ics: YESNO = ''
    inhaledRegimen: Literal['','ninguno','mono','dual','triple','laba_ics'] = ''
    monotherapyClass: Literal['','lama','laba'] = ''
    roflumilast: YESNO = ''
    azithromycin: YESNO = ''
    rescuePrescription: Literal['','saba','sama','ambos','otro','ninguno','nc'] = ''
    medicationDetails: str = Field('', max_length=500)  # only synthetic medication names
    reason: Literal['', 'abandono', 'fallecimiento', 'traslado', 'no_contacto', 'otro'] = ''
    rev: int | None = None

    @field_validator('patient')
    @classmethod
    def patient_id(cls, v):
        if not CODE.fullmatch(v):
            raise ValueError('Código de participante incorrecto')
        return v

    @field_validator('date')
    @classmethod
    def visit_date(cls, v):
        if not v:
            raise ValueError('La fecha es obligatoria')
        return validate_date(v)

    @field_validator('ianusCheckedAt')
    @classmethod
    def ianus_optional_date(cls, v):
        return validate_date(v)

    @model_validator(mode='after')
    def rules(self):
        if self.ianusVerified == 'no' and self.ianusCollected in ('si', 'no'):
            raise ValueError('No puede declarar recogida Sí/No cuando IANUS no es verificable')
        if self.ianusVerified == 'si' and self.ianusCollected == 'nv':
            raise ValueError('NV solo es válido si IANUS no es verificable')
        regimen_map = {'ninguno': ('no','no','no'), 'dual': ('si','si','no'),
                       'triple': ('si','si','si'), 'laba_ics': ('no','si','si')}
        if self.inhaledRegimen == 'mono':
            if self.monotherapyClass not in ('lama','laba'):
                raise ValueError('Seleccione LAMA o LABA para la monoterapia')
            regimen_map['mono'] = ('si','no','no') if self.monotherapyClass == 'lama' else ('no','si','no')
        elif self.monotherapyClass:
            raise ValueError('El tipo de monoterapia solo procede con LAMA o LABA')
        if self.inhaledRegimen:
            self.lama, self.laba, self.ics = regimen_map[self.inhaledRegimen]
        if self.status == 'no_realizada' and not self.reason:
            raise ValueError('Debe indicar motivo de visita no realizada')
        if self.status == 'completa':
            if not all(getattr(self, k) in ('si', 'no') for k in ('rescue', 'exacerb', 'dyspnea', 'activity')):
                raise ValueError('RADAR incompleto')
            if self.cat is None or self.mmrc is None or not self.action:
                raise ValueError('Faltan CAT, mMRC o plan clínico')
        return self


class Episode(Strict):
    @model_validator(mode='after')
    def episode_rules(self):
        if self.kind == 'otro' and self.severity not in ('no_aplica','indeterminada'):
            raise ValueError('Otro evento: gravedad no aplicable o por confirmar')
        if self.kind == 'agudizacion' and self.severity == 'no_aplica':
            raise ValueError('Agudización: debe indicar gravedad moderada, grave o pendiente')
        if self.emergencyDate and self.emergencyStatus != 'si':
            raise ValueError('Fecha de Urgencias exige respuesta Sí (R081)')
        if self.admissionDate and self.admissionStatus != 'si':
            raise ValueError('Fecha de ingreso exige respuesta Sí (R082)')
        return self

