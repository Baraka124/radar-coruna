# Synthetic-only staging. Do not use real patient data.
RADAR_MODE=synthetic_staging
RADAR_PUBLIC_ORIGIN=https://your-synthetic-radar-domain.example
RADAR_PERSISTENT_DATA_DIR=/data
RADAR_DB=/data/radar_synthetic.sqlite3
RADAR_WORKERS=1
RADAR_SEED_DEMO=0
RADAR_BOOTSTRAP_ADMIN_USER=radar.admin
# Set this in the host's secret manager; never commit a real value.
RADAR_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_SECRET_16_PLUS_CHARS
