# Synthetic staging ONLY; never upload real clinical data to this configuration.
RADAR_STORAGE=postgres
RADAR_MODE=synthetic_staging
RADAR_PUBLIC_ORIGIN=https://YOUR-INDEPENDENT-RADAR-STAGING-DOMAIN
RADAR_EXPECTED_PROJECT_REF=vqdpkzlrzwchjumpbqta
# Obtain from Supabase Connect > Session pooler. URL is a BACKEND-ONLY secret.
# Download the project CA certificate and configure SSL verification as documented.
RADAR_DATABASE_URL=postgresql://postgres.vqdpkzlrzwchjumpbqta:DB-PASSWORD@POOLER-HOST:5432/postgres?sslmode=verify-full
RADAR_BOOTSTRAP_ADMIN_USER=radar.admin
RADAR_BOOTSTRAP_ADMIN_PASSWORD=SET_UNIQUE_LONG_SECRET_OUTSIDE_SOURCE
RADAR_SEED_DEMO=0
